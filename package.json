{
  "name": "swing-music-app",
  "version": "1.2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.swingmusic.app",
    "productName": "Swing Music",
    "icon": "assets/swingmusiclogo.ico",
    "win": {
      "target": "nsis",
      "icon": "assets/swingmusiclogo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/swingmusiclogo.ico",
      "uninstallerIcon": "assets/swingmusiclogo.ico"
    }
  }
}
